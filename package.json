{
  "name": "root",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "24.19.0",
    "npm": "12.0.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-modules-commonjs": "^8.0.1",
    "@babel/plugin-transform-private-methods": "^8.0.1",
    "@babel/plugin-transform-private-property-in-object": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/config-lerna-scopes": "^21.2.0",
    "@commitlint/cz-commitlint": "^21.2.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-loader": "^10.1.1",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "babel-plugin-react-native-web": "^0.21.2",
    "commitizen": "^4.3.2",
    "core-js": "^3.50.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-webpack-plugin": "^6.0.0",
    "globals": "^17.9.0",
    "inquirer": "^14.0.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-mock": "^30.4.1",
    "jest-mock-extended": "^4.0.1",
    "lerna": "^10.0.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "regenerator-runtime": "^0.14.1",
    "ts-loader": "^9.6.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "undici": "^8.10.0",
    "webpack": "^5.109.2",
    "webpack-auto-inject-version-next": "^1.2.4",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  },
  "scripts": {
    "test": "echo 'Workaround for npm rfc #575'; lerna exec --ignore @keneanung/iron-realms-nexus-typings --no-bail --no-progress --stream -- npx jest --testLocationInResults --collect-coverage --config jestconfig.js && npm run test:roundtrip",
    "test:roundtrip": "jest --testLocationInResults --config jestconfig.js tests/nexusPackageRoundtrip.test.ts",
    "lint": "lerna exec --no-bail --no-progress --stream -- eslint . --ext .ts,.tsx",
    "webpack": "lerna exec --no-bail --no-progress --stream --ignore @keneanung/iron-realms-nexus-typings --ignore @keneanung/nexus-package-builder --ignore @keneanung/nexus-package-splitter --ignore @keneanung/nexus-simplified-scripting-converter -- webpack build --mode development",
    "webpackProd": "lerna exec --no-bail --no-progress --stream --ignore @keneanung/iron-realms-nexus-typings --ignore @keneanung/nexus-package-builder --ignore @keneanung/nexus-package-splitter --ignore @keneanung/nexus-simplified-scripting-converter -- webpack build --mode production",
    "build": "lerna run --no-bail --no-progress build",
    "nxs": "lerna run --no-bail --no-progress nxs",
    "nxsProd": "lerna run --no-bail --no-progress nxsProd",
    "verify:packages": "node scripts/verify-packages.mjs",
    "verify:website": "npm --prefix website ci && npm --prefix website run typecheck && npm --prefix website run build",
    "verify:code": "npm test && npm run lint && npm run build",
    "verify:artifacts": "npm run build && npm run webpackProd && npm run nxsProd && npm run verify:packages && npm run verify:website",
    "verify": "npm run verify:code && npm run verify:artifacts",
    "release:publish": "lerna publish from-package --yes --ignore-scripts",
    "commit": "git diff --cached --quiet && echo 'No staged files to commit.' || git-cz"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "overrides": {
    "lerna": "$lerna",
    "@commitlint/cz-commitlint": {
      "inquirer": "$inquirer"
    }
  }
}
