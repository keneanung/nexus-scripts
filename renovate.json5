{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':dependencyDashboard',
    ':semanticCommits',
    ':semanticCommitScopeDisabled',
    'group:monorepos',
  ],
  schedule: ['before 9am on Monday'],
  timezone: 'Europe/Berlin',
  minimumReleaseAge: '7 days',
  internalChecksFilter: 'strict',
  rangeStrategy: 'bump',
  vulnerabilityAlerts: {
    labels: ['security'],
    schedule: ['at any time'],
  },
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 9am on the first day of the month'],
  },
  packageRules: [
    {
      description: 'Release runtime dependency updates as fixes',
      matchManagers: ['npm'],
      matchDepTypes: ['dependencies'],
      semanticCommitType: 'fix',
      semanticCommitScope: 'deps',
    },
    {
      description: 'Group non-major runtime dependency updates',
      matchManagers: ['npm'],
      matchDepTypes: ['dependencies'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'runtime dependencies (non-major)',
    },
    {
      description: 'Group and automerge safe non-major development updates',
      matchManagers: ['npm'],
      matchDepTypes: ['devDependencies'],
      matchPackageNames: ['!typescript', '!@typescript/native', '!react', '!react-dom'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'development dependencies (non-major)',
      automerge: true,
      automergeType: 'pr',
    },
    {
      description: 'Keep the side-by-side TypeScript compilers together',
      matchManagers: ['npm'],
      matchPackageNames: ['typescript', '@typescript/native'],
      groupName: 'TypeScript compilers',
    },
    {
      description: 'Keep the website dependency updates together',
      matchManagers: ['npm'],
      matchFileNames: ['website/**'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'website dependencies (non-major)',
    },
    {
      description: 'Match the React runtime supplied by Nexus',
      matchManagers: ['npm'],
      matchPackageNames: ['react', 'react-dom'],
      allowedVersions: '19.2.4',
    },
  ],
  ignoreDeps: ['@mdx-js/react'],
}
